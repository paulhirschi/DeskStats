# Copy this file to .env and fill in your key.
# Used by app/qotd.py to generate the "of the day" widgets via the Claude API.

ANTHROPIC_API_KEY=sk-ant-...

# Optional — defaults to a fast/cheap model since each item is short and
# generated at most once per day per widget type.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
